# Server & Origins
PORT=5000
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_PUBLIC_URL=https://your-backend.vercel.app

# AI Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Auth Verification (must match frontend Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostgreSQL Database Configuration (Supabase Transaction Pooler recommended on Vercel)
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=postgres
DB_SCHEMA=uncold
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Google OAuth for Direct Gmail Sending & Reply Tracking
GOOGLE_CONSOLE_CLIENT_ID=your_google_client_id
GOOGLE_CONSOLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_GMAIL_REDIRECT_URI=https://your-backend.vercel.app/api/gmail/callback

# 32+ char secret for AES-256-GCM token encryption & signed OAuth state
TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret_string
